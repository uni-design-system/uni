{
  "name": "uni",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "version-packages": "changeset version && turbo run build-storybook --filter=@uni-design-system/uni-angular && pnpm --filter @uni-design-system/uni-mcp build-index && pnpm --filter @uni-design-system/uni-mcp build",
    "dev": "turbo run storybook",
    "dev:hub": "turbo run storybook --filter=@uni-design-system/uni-docs --filter=@uni-design-system/uni-react --filter=@uni-design-system/uni-angular",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "storybook": "turbo run storybook --filter=@uni-design-system/uni-angular",
    "storybook:react": "turbo run storybook --filter=@uni-design-system/uni-react",
    "build-storybook": "turbo run build-storybook"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^25.6.0",
    "csstype": "^3.2.3",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "turbo": "^2.9.8",
    "typescript": "~6.0.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5"
  },
  "pnpm": {
    "overrides": {
      "storybook": "10.6.0",
      "@storybook/angular": "10.6.0",
      "@storybook/addon-essentials": "10.6.0",
      "@storybook/addon-links": "10.6.0",
      "@storybook/addon-interactions": "10.6.0",
      "@storybook/addon-docs": "10.6.0",
      "@storybook/addon-a11y": "10.6.0",
      "@storybook/addon-toolbars": "10.6.0",
      "@storybook/manager-api": "10.6.0",
      "@storybook/preview-api": "10.6.0",
      "@storybook/types": "10.6.0",
      "react-dom": "^18.3.1",
      "@angular-devkit/schematics>magic-string": "0.30.21"
    }
  }
}
