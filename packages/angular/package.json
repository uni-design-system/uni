{
  "name": "@uni-design-system/uni-angular",
  "version": "11.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uni-design-system/uni",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "private": false,
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-schematics.mjs && pnpm ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "type-check": "tsc --noEmit",
    "build:schematics": "node scripts/build-schematics.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src && node scripts/check-mdx-braces.mjs",
    "lint:mdx": "node scripts/check-mdx-braces.mjs",
    "storybook": "pnpm ng run @uni-design-system/uni-angular:storybook",
    "build-storybook": "pnpm architect @uni-design-system/uni-angular:build-storybook",
    "release": "pnpm build && pnpm changeset publish",
    "docs:api": "node scripts/generate-api.mjs"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@emotion/css": "^11.0.0",
    "@uni-design-system/uni-core": "workspace:^"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@angular-devkit/architect": "^0.2201.7",
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular-devkit/core": "22.1.7",
    "@angular-devkit/schematics": "^22.1.7",
    "@angular/compiler": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@emotion/css": "^11.0.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "@types/react": "^18.3.28",
    "@uni-design-system/tsconfig": "workspace:*",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
}
