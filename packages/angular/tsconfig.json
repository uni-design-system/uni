{
  "extends": "@uni-design-system/tsconfig/base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "..",
    "module": "ESNext",
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "jsx": "react-jsx",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*", "**/*"],
  // `prototypes/**` are standalone design explorations, deliberately outside
  // the build — they reference modules and deps that do not exist here, and
  // their decisions are already recorded. Excluding them is what lets `build`
  // run a real `tsc --noEmit` over the code that ships.
  "exclude": ["../node_modules", "../dist", "prototypes/**", "storybook-static/**"]
}
